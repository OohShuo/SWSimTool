<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <AssemblyName>SWSimTool.CandidateRunner</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" Condition="'$(TargetFramework)' == 'net48'" />
    <Reference Include="System.Core" Condition="'$(TargetFramework)' == 'net48'" />
    <Reference Include="System.Xml" Condition="'$(TargetFramework)' == 'net48'" />
    <Reference Include="System.Xml.Linq" Condition="'$(TargetFramework)' == 'net48'" />
    <Reference Include="System.Web.Extensions" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\tools\ToolBackendTests.cs" />
    <Compile Include="..\tools\Test-MuJoCoTools.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\runtime\python\*.py">
      <Link>mujoco_backend\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SWSimTool.Core/SWSimTool.Core.csproj">
      <Name>SWSimTool.Core</Name>
    </ProjectReference>
    <ProjectReference Include="../../src/SWSimTool.Application/SWSimTool.Application.csproj">
      <Name>SWSimTool.Application</Name>
    </ProjectReference>
    <ProjectReference Include="../../src/SWSimTool.Infrastructure/SWSimTool.Infrastructure.csproj">
      <Name>SWSimTool.Infrastructure</Name>
    </ProjectReference>
  </ItemGroup>
</Project>
