<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>SWSimTool.Cli</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SWSimTool.Application/SWSimTool.Application.csproj" />
    <ProjectReference Include="../SWSimTool.Infrastructure/SWSimTool.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../runtime/python/*.py">
      <Link>mujoco_backend/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
